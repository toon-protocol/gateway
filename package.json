{
  "name": "toon-workload-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "A Workload Gateway: fronts a TOON Network workload at a stable hostname, keyed by its workload id",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "start": "node src/main.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:deploy": "node --test \"deploy/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json",
    "sandcastle:ready": "npx tsx .sandcastle/ready-issues.ts",
    "sandcastle:implement": "npx tsx .sandcastle/agent-implement-issue.ts"
  },
  "dependencies": {
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "@toon-protocol/client": "^4.1.2",
    "socks": "^2.8.10",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
